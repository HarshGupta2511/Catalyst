// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  password    String
  designation String
  department  String
  role        String   @default("Employee")
  phone       String?
  isProjectLead Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  raisedPRs   PurchaseRequest[] @relation("RaisedBy")
  leadPRs     PurchaseRequest[] @relation("ProjectLead")
  stages      PurchaseRequestStage[]
  auditLogs   AuditLog[]
}

model PurchaseRequest {
  id                String   @id @default(uuid())
  prNumber          String   @unique
  projectName       String
  description       String
  raisedById        String
  projectLeadId     String
  designation       String
  department        String
  priority          String   @default("Medium")
  status            String   @default("Draft")
  totalAmount       Float
  estimatedDelivery String
  stakeholders      String[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  raisedBy    User   @relation("RaisedBy", fields: [raisedById], references: [id])
  projectLead User   @relation("ProjectLead", fields: [projectLeadId], references: [id])
  stages      PurchaseRequestStage[]
  escalations EscalationJob[]
  invoices    Invoice[]
  grn         GRN[]
  auditLogs   AuditLog[]
}

model PurchaseRequestStage {
  id             String    @id @default(uuid())
  prId           String
  stageName      String
  stageOrder     Int
  assignedToId   String
  status         String    @default("pending")
  completedById  String?
  completedAt    DateTime?
  rejectedReason String?
  blockingReason String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  pr          PurchaseRequest @relation(fields: [prId], references: [id])
  assignedTo  User            @relation(fields: [assignedToId], references: [id])
  escalations EscalationJob[]
}

model EscalationJob {
  id          String    @id @default(uuid())
  prId        String
  stageId     String
  emailCount  Int       @default(0)
  lastSentAt  DateTime?
  nextSendAt  DateTime?
  resolved    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  pr    PurchaseRequest      @relation(fields: [prId], references: [id])
  stage PurchaseRequestStage @relation(fields: [stageId], references: [id])
}

model Invoice {
  id        String   @id @default(uuid())
  prId      String
  amount    Float
  bookedAt  DateTime @default(now())
  notes     String?

  pr PurchaseRequest @relation(fields: [prId], references: [id])
}

model GRN {
  id         String   @id @default(uuid())
  prId       String
  receivedBy String
  receivedAt DateTime @default(now())
  quantity   Int
  notes      String?

  pr PurchaseRequest @relation(fields: [prId], references: [id])
}
model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String
  timestamp DateTime @default(now())

  user            User            @relation(fields: [userId], references: [id])
  purchaseRequest PurchaseRequest @relation(fields: [entityId], references: [id])
}